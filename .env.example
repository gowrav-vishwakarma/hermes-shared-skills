# =============================================================================
# Shared-skills environment variables
# =============================================================================
# Skills under ~/.hermes/shared-skills/ require these env vars to be set in
# each profile's own .env (e.g. ~/.hermes/profiles/<profile>/.env).
#
# Hermes auto-sources the active profile's .env (terminal.auto_source_bashrc:
# true), so once the values below are set in the profile .env they are
# available to every script the agent runs.
#
# Recovery (when a script complains a required var is missing):
#   set -a; source "$PROFILE_ROOT/.env"; set +a
#
# Copy this file to your profile's .env (or merge the keys you need) and
# replace the placeholder values with real, absolute paths for that profile.
# =============================================================================


# ---------------------------------------------------------------------------
# Profile paths
# Required by: video-create-workflow, wan2gp-image-generation,
#              wan2gp-video-generation, wan2gp-movie-pipeline, working-acestep
# ---------------------------------------------------------------------------
PROFILE_ROOT=/home/<user>/.hermes/profiles/<profile>
PROFILE_HOME=$PROFILE_ROOT/home
PROFILE_SKILLS=$PROFILE_ROOT/skills
POSTS_DIR=$PROFILE_HOME/posts
MEMORY_FILE=$PROFILE_ROOT/memories/MEMORY.md
JOURNEY_FILE=$PROFILE_HOME/journey.jsonl


# ---------------------------------------------------------------------------
# WanGP (image + video generation via wgp.py)
# Required by: wan2gp-image-generation, wan2gp-video-generation,
#              wan2gp-movie-pipeline
#   WAN_APP_DIR  : checkout root of WanGP (the directory containing wgp.py)
#   WAN_PYTHON   : python interpreter to invoke wgp.py with (defaults to
#                  $WAN_APP_DIR/env/bin/python if unset, but setting it
#                  explicitly is recommended)
# ---------------------------------------------------------------------------
WAN_APP_DIR=/path/to/wan.git/app
WAN_PYTHON=$WAN_APP_DIR/env/bin/python


# ---------------------------------------------------------------------------
# Asset library (consumed by asset_manifest.py and helpers)
# Required by: wan2gp-image-generation, wan2gp-movie-pipeline
#   CHARACTER_ASSETS_DIR      : directory holding generated character assets
#   CHARACTER_ASSETS_MANIFEST : JSON manifest tracking assets in that dir
#   CHARACTER_BASE            : base portrait used as the identity reference
# ---------------------------------------------------------------------------
CHARACTER_ASSETS_DIR=$PROFILE_HOME/assets
CHARACTER_ASSETS_MANIFEST=$CHARACTER_ASSETS_DIR/assets.json
CHARACTER_BASE=$PROFILE_HOME/character.png


# ---------------------------------------------------------------------------
# ACE-Step music generation
# Required by: working-acestep (only if it is in the profile's skills.auto_load)
#   ACESTEP_DIR        : checkout root of ACE-Step
#   ACESTEP_API_URL    : base URL of the running ACE-Step API server
#   ACESTEP_OUTPUT_DIR : directory where generated audio is written
# ---------------------------------------------------------------------------
ACESTEP_DIR=/path/to/ACE-Step-1.5
ACESTEP_API_URL=http://127.0.0.1:8001
ACESTEP_OUTPUT_DIR=$PROFILE_HOME/acestep_output
